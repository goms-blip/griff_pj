# 실시간 행사 Q&A 솔루션 v2 — 환경변수 템플릿
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 커밋되지 않습니다)
#   cp .env.example .env.local

# ── Supabase ────────────────────────────────────────────────
# 대시보드 → Settings → API Keys
SUPABASE_URL=https://<project-ref>.supabase.co
# anon 키는 브라우저 노출 OK (RLS 로 보호). index.html 상단 상수와 같은 값이어야 합니다.
#   → npm run verify 가 .env.local 값을 읽어 index.html 에 자동 반영합니다.
SUPABASE_ANON_KEY=
# service_role 키는 RLS 를 우회합니다. 절대 프론트/저장소에 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=

# ── 운영자 콘솔 ──────────────────────────────────────────────
# 프로젝트 생성·삭제, 참가자 개인정보 엑셀 다운로드가 전부 가능한 마스터 토큰.
# 충분히 긴 랜덤 문자열로 설정하세요.
ADMIN_CONSOLE_TOKEN=

# ── 번역 (Gemini → 실패 시 GPT 폴백) ─────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 미지정 시 gemini-3.6-flash. 404 면 gemini-flash-latest → gemini-2.5-flash 순으로 재시도.
GEMINI_MODEL=

# 예비 제공자. Gemini 가 키 오류·한도 초과·안전필터·타임아웃 등으로 실패하면 이쪽으로 넘어갑니다.
# 비워두면 폴백 없이 Gemini 오류가 그대로 노출됩니다.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# 미지정 시 gpt-4o-mini. 사용 불가면 gpt-4o 로 재시도.
OPENAI_MODEL=

# ── 기타 ────────────────────────────────────────────────────
# Vercel Cron 이 /api/admin/cron/sheet-sync 를 호출할 때 쓰는 시크릿 (아무 랜덤 문자열).
# Vercel 프로젝트 환경변수에도 같은 값으로 등록해야 합니다.
CRON_SECRET=

# 로컬 서버 포트
PORT=8787
