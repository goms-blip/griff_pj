# LivePoll 환경변수 템플릿
# 사용법: cp .env.example .env.local 후 실제 값 채우기
# .env.local 은 git 무시 대상입니다. 실제 값을 이 파일에 적어 커밋하지 마세요.

# Supabase 프로젝트 URL (예: https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=

# 공개 클라이언트용 anon 키 (RLS 로 보호되는 전제)
SUPABASE_ANON_KEY=

# 서버 전용 service_role 키 — RLS 를 우회합니다.
# 절대 프론트엔드 코드나 저장소에 노출하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# /admin 콘솔과 /api/admin/* 를 보호하는 토큰.
# 충분히 긴 무작위 문자열을 쓰세요 (예: openssl rand -hex 32)
ADMIN_CONSOLE_TOKEN=

# 로컬 개발 포트
PORT=8787
